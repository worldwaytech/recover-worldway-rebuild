{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vumlkmdesyhplylqtpbl.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "worldway-travels-group",
      "version": "0.1.0",
      "title": "Worldway Travels Group"
    },
    "tools": [
      {
        "name": "search_flights",
        "title": "Search flights",
        "description": "Search live Worldway flight inventory. Returns fares, cabins and offer IDs.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "description": "Origin IATA code or city, e.g. DEL or Delhi."
            },
            "destination": {
              "type": "string",
              "description": "Destination IATA code or city, e.g. BOM or Mumbai."
            },
            "depart_date": {
              "type": "string",
              "description": "Outbound date, YYYY-MM-DD."
            },
            "return_date": {
              "description": "Return date YYYY-MM-DD for round-trip.",
              "type": "string"
            },
            "passengers": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "cabin": {
              "default": "economy",
              "type": "string",
              "enum": [
                "economy",
                "premium_economy",
                "business",
                "first"
              ]
            }
          },
          "required": [
            "origin",
            "destination",
            "depart_date"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_hotels",
        "title": "Search hotels",
        "description": "Search live hotel availability and rates from Worldway.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "destination": {
              "type": "string",
              "description": "City or hotel name, e.g. Dubai or The Ritz-Carlton Paris."
            },
            "check_in": {
              "type": "string",
              "description": "Check-in date, YYYY-MM-DD."
            },
            "check_out": {
              "type": "string",
              "description": "Check-out date, YYYY-MM-DD."
            },
            "guests": {
              "default": 2,
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "rooms": {
              "default": 1,
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "destination",
            "check_in",
            "check_out"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "wallet_balance",
        "title": "My wallet balance",
        "description": "Return the signed-in user's Worldway wallet balances across currencies.",
        "annotations": {
          "readOnlyHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "wallet_transactions",
        "title": "My wallet transactions",
        "description": "List recent wallet transactions for the signed-in user.",
        "annotations": {
          "readOnlyHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Max number of transactions to return.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
